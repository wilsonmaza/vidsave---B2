# Porta onde o backend fica à escuta
PORT=3000

# development | production
NODE_ENV=development

# Origem permitida para o CORS. '*' é só para desenvolvimento local.
# Em produção: o domínio do frontend, SEM barra no fim
# (ex.: https://vidsave-bay.vercel.app). Várias origens: separar por vírgula.
CORS_ORIGIN=*

# Ativar só quando existir exatamente UM proxy confiável à frente da app
# (ex.: o load balancer da Render/Railway/Fly.io). Nunca ativar sem isso —
# ver security/client-ip.js para o porquê.
TRUST_PROXY=false

# Rate limiting geral (por IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=15

# Limite mais rigoroso, específico para /api/resolve (ainda não existe)
RESOLVE_RATE_LIMIT_MAX=10

# Limite próprio para /api/download/:downloadId (I2 — antes só tinha o
# limite de concorrência abaixo, sem nenhum limite de frequência)
DOWNLOAD_RATE_LIMIT_MAX=20

# Downloads simultâneos permitidos por IP (para /api/download, ainda não existe)
DOWNLOAD_MAX_CONCURRENT_PER_IP=2

# Desativa o provider de demonstração (útil só para testar o registry vazio)
DEMO_PROVIDER_ENABLED=true

# Desativa o provider do Internet Archive (útil só para testar o registry sem ele)
ARCHIVE_ORG_PROVIDER_ENABLED=true

# Quanto tempo (ms) um downloadId fica válido depois de criado no /api/resolve
DOWNLOAD_TTL_MS=900000

# Size Guard — tamanho máximo aceite para um download, em bytes. Rejeita
# antecipadamente (via sizeBytes declarado pelo provider) e corta a
# gravação em tempo real se o stream real exceder o limite. 500 MB.
DOWNLOAD_MAX_SIZE_BYTES=524288000

# Limpeza periódica de ficheiros órfãos (Etapa 6.4): compara o que está em
# disco com o que o DownloadStore conhece e apaga o que não tiver registo.
# Qualquer valor diferente de "false" conta como ativado.
ORPHAN_CLEANUP_ENABLED=true

# Intervalo (ms) entre cada limpeza periódica. 5 minutos.
ORPHAN_CLEANUP_INTERVAL_MS=300000

# Nº máximo de tentativas ao apagar um ficheiro órfão antes de desistir.
ORPHAN_CLEANUP_MAX_RETRIES=3

# Espera (ms) entre tentativas de apagar o mesmo ficheiro órfão.
ORPHAN_CLEANUP_RETRY_DELAY_MS=1000
